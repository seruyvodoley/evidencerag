# Add ONLY after audit, owner-approved hostname and review of the shared proxy.
# This example assumes the proxy can reach the host loopback address.
# A bridge-networked Caddy container cannot use host loopback this way.
evidence.example.org {
    request_body {
        max_size 11MB
    }
    encode gzip
    reverse_proxy 127.0.0.1:8077
    header Strict-Transport-Security "max-age=31536000"
    # Do not enable an access log containing private addresses or cookies.
}
